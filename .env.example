APP_NAME=VotaFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ── Banco de dados ───────────────────────────────────────────────────────────
# Desenvolvimento rápido: sqlite. Produção: MySQL 8+ (InnoDB).
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=votaflow
# DB_USERNAME=votaflow
# DB_PASSWORD=

# ── Sessão / cache / fila (em produção use Redis; ver docs/DEPLOY.md) ────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies Secure: true por padrão quando APP_ENV=production
# SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
# Broadcast: log/null não exigem infraestrutura. Tempo real real: reverb ou pusher.
BROADCAST_CONNECTION=log

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Login com Google (https://console.cloud.google.com/apis/credentials) ─────
# URI de redirecionamento autorizada: {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ── VotaFlow ─────────────────────────────────────────────────────────────────
# E-mails (separados por vírgula) que viram ADMIN no primeiro login.
VOTAFLOW_ADMIN_EMAILS=
VOTAFLOW_NOME=VotaFlow

# Atrás de load balancer/proxy: "*" ou lista de IPs separados por vírgula.
# TRUSTED_PROXIES=*
